MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
PORT=3000

BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# ===== 大模型（AI 润色 + 评价）=====
# 首选：任意 OpenAI 兼容接口（免费额度友好）。三项都填了就优先走这里，忽略下面的千帆配置。
# 智谱免费模型：    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.7-flash（或 glm-4-flash）
# 硅基流动：          LLM_BASE_URL=https://api.siliconflow.cn/v1        LLM_MODEL=Qwen/Qwen3-8B
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=your_llm_api_key
# LLM_MODEL=glm-4.7-flash

# 备选：百度千帆（课件默认方案）
# 方式一：千帆控制台「应用接入」创建应用，拿 API Key / Secret Key
# 方式二：千帆控制台「API Key 管理」拿到的 bce-v3/ALTAK-... 直接填在 QIANFAN_API_KEY，SECRET_KEY 留空
# 两项都留空时，回退使用上面的 BAIDU_API_KEY / BAIDU_SECRET_KEY
QIANFAN_API_KEY=your_qianfan_api_key
QIANFAN_SECRET_KEY=your_qianfan_secret_key
# 可选：v1 接口默认 eb-instant；bce-v3 接口默认 ernie-5.1
# QIANFAN_MODEL=ernie-5.1

# 配置完执行 node scripts/check-llm.js --full 自检
# 千帆用户可加 --list 查看当前 Key 可用的模型
